---
import { GraduationCap, MagnifyingGlassPlus } from '@phosphor-icons/react';
import SectionHead from './SectionHead.astro';
import { type Lang } from '../lib/site';
import { t } from '../i18n';

interface Props {
  lang: Lang;
  full?: boolean;
}
const { lang, full = false } = Astro.props;
const d = t(lang);
const e = d.education;
---

<section id="education" class="scroll-mt-24 px-4 py-20 md:px-6 md:py-24" aria-labelledby="edu-title">
  <div class="mx-auto max-w-6xl" data-reveal>
    <SectionHead id="edu-title" title={e.title} />
    <div class="grid gap-12 lg:grid-cols-[1.1fr_1fr]">
      <div class="flex flex-col gap-6">
        <p class="flex gap-4 text-lg text-ink-soft">
          <GraduationCap size={32} weight="duotone" className="shrink-0 text-sage" />
          <span>{e.text}</span>
        </p>
        <dl class="grid grid-cols-2 gap-4">
          {
            e.stats.map((s) => (
              <div class="rounded-3xl border border-line bg-surface p-6">
                <dt class="sr-only">{s.label}</dt>
                <dd>
                  <span class="block text-4xl font-bold tracking-tight text-sage md:text-5xl" data-count={s.value}>
                    {s.value}
                  </span>
                  <span class="mt-2 block text-sm text-muted">{s.label}</span>
                </dd>
              </div>
            ))
          }
        </dl>
        <p class="rounded-3xl bg-sky-tint p-6 text-base text-ink-soft">{e.beginner}</p>
        {
          full && (
            <div>
              <h3 class="mb-4 text-xl font-semibold text-ink">{e.subjectsTitle}</h3>
              <ul class="flex flex-wrap gap-2">
                {e.subjects.map((s) => (
                  <li class="rounded-full border border-line bg-surface px-3 py-1 text-sm text-ink-soft">{s}</li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
      <div>
        <ul class="grid grid-cols-3 gap-3">
          {
            e.diplomas.map((img, i) => (
              <li>
                <button
                  type="button"
                  data-lightbox={`${img.src}.webp`}
                  data-alt={img.alt}
                  class="group relative block w-full overflow-hidden rounded-2xl border border-line bg-surface transition duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-1"
                  style={`transform: rotate(${[-2, 1, 3][i]}deg)`}
                  aria-label={img.alt}
                >
                  <img
                    src={`${img.src}-thumb.webp`}
                    alt={img.alt}
                    width="420"
                    height="580"
                    loading="lazy"
                    decoding="async"
                    class="aspect-[3/4] w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                  <span class="absolute bottom-2 right-2 grid size-8 place-items-center rounded-lg bg-surface/90 text-ink opacity-0 transition-opacity duration-300 group-hover:opacity-100">
                    <MagnifyingGlassPlus size={16} />
                  </span>
                </button>
              </li>
            ))
          }
        </ul>
        <p class="mt-4 text-sm text-muted">{e.diplomaHint}</p>
        {
          !full && (
            <ul class="mt-6 flex flex-wrap gap-2">
              {e.subjects.slice(0, 5).map((s) => (
                <li class="rounded-full border border-line bg-surface px-3 py-1 text-sm text-ink-soft">{s}</li>
              ))}
            </ul>
          )
        }
      </div>
    </div>
  </div>

  <dialog id="lightbox" class="m-auto max-h-[92dvh] max-w-[min(92vw,720px)] rounded-3xl bg-surface p-2 backdrop:bg-ink/60 backdrop:backdrop-blur-sm">
    <form method="dialog" class="absolute right-4 top-4 z-10">
      <button class="rounded-xl bg-surface/90 px-3 py-2 text-sm font-semibold text-ink shadow" aria-label={d.common.close}>{d.common.close}</button>
    </form>
    <img id="lightbox-img" src="" alt="" class="max-h-[88dvh] w-auto rounded-2xl" />
  </dialog>
</section>

<script>
  // Счётчики цифр при появлении
  const counters = document.querySelectorAll<HTMLElement>('[data-count]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const cio = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const el = entry.target as HTMLElement;
        cio.unobserve(el);
        if (reduce) continue;
        const to = Number(el.dataset.count);
        const start = performance.now();
        const dur = 1400;
        const step = (now: number) => {
          const k = Math.min(1, (now - start) / dur);
          const eased = 1 - Math.pow(1 - k, 4);
          el.textContent = String(Math.round(to * eased));
          if (k < 1) requestAnimationFrame(step);
        };
        el.textContent = '0';
        requestAnimationFrame(step);
      }
    },
    { threshold: 0.6 }
  );
  counters.forEach((c) => cio.observe(c));

  // Просмотр диплома
  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
  const img = document.getElementById('lightbox-img') as HTMLImageElement | null;
  document.querySelectorAll<HTMLElement>('[data-lightbox]').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (!dialog || !img) return;
      img.src = btn.dataset.lightbox!;
      img.alt = btn.dataset.alt || '';
      dialog.showModal();
    });
  });
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>
