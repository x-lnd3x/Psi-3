---
interface Props {
  items: string[];
}
const { items } = Astro.props;
const row = [...items, ...items];
---

<div class="marquee relative overflow-hidden bg-sage py-4" aria-hidden="true">
  <div class="marquee-track flex w-max gap-8">
    {
      row.map((it) => (
        <span class="flex items-center gap-8 whitespace-nowrap text-lg font-semibold text-white">
          {it}
          <span class="size-2 rounded-full bg-white/50" />
        </span>
      ))
    }
  </div>
</div>
