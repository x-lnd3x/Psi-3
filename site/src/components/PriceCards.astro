---
import { Gift, Package, Info, Sparkle } from '@phosphor-icons/react';
import SectionHead from './SectionHead.astro';
import { site, formatPrice, type Lang } from '../lib/site';
import { t } from '../i18n';

interface Props {
  lang: Lang;
  showHead?: boolean;
}
const { lang, showHead = true } = Astro.props;
const p = t(lang).prices;
const whoFor: Record<string, string> = { intro: '', pair: 'pair', family: 'family', individual: 'self' };
---

<section id="prices" class="scroll-mt-24 bg-surface px-4 py-20 md:px-6 md:py-24" aria-labelledby="prices-title">
  <div class="mx-auto max-w-6xl" data-reveal>
    {showHead && <SectionHead id="prices-title" title={p.title} subtitle={p.subtitle} />}
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        p.items.map((it) => (
          <li
            class:list={[
              'relative flex flex-col rounded-3xl border bg-surface p-6 transition duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-1',
              it.featured ? 'border-sage shadow-[0_16px_48px_rgba(35,128,95,0.14)]' : 'border-line',
            ]}
          >
            {it.featured && (
              <span class="absolute -top-3 left-6 flex items-center gap-1 rounded-full bg-sage px-3 py-1 text-xs font-semibold text-white">
                <Sparkle size={12} weight="fill" /> {p.popular}
              </span>
            )}
            <h3 class="text-lg font-semibold text-ink">{it.name}</h3>
            <p class="mt-1 text-sm text-muted">{it.duration}</p>
            <p class="mt-6 text-4xl font-bold tracking-tight text-ink">
              {formatPrice(site.prices[it.priceKey as keyof typeof site.prices], lang)}
            </p>
            <p class="mt-4 flex-1 text-base text-muted">{it.text}</p>
            <button
              type="button"
              data-book={whoFor[it.id]}
              class:list={[
                'mt-6 rounded-xl px-3 py-2 text-base font-semibold transition duration-300 active:scale-[0.98]',
                it.featured ? 'bg-sage text-white hover:bg-sage-deep' : 'bg-mist text-ink hover:bg-sage-tint',
              ]}
            >
              {p.choose}
            </button>
          </li>
        ))
      }
    </ul>
    <div class="mt-4 grid gap-4 md:grid-cols-3">
      <div class="flex gap-4 rounded-3xl border border-line bg-sky-tint p-6">
        <Package size={28} weight="duotone" className="shrink-0 text-sky" />
        <div>
          <h3 class="text-base font-semibold text-ink">{p.packageTitle}</h3>
          <p class="mt-1 text-sm text-ink-soft">{p.packageText}</p>
        </div>
      </div>
      <div class="flex gap-4 rounded-3xl border border-line bg-sage-tint p-6">
        <Gift size={28} weight="duotone" className="shrink-0 text-sage" />
        <div>
          <h3 class="text-base font-semibold text-ink">{p.giftTitle}</h3>
          <p class="mt-1 text-sm text-ink-soft">{p.giftText}</p>
          <a href={site.contacts.telegram} target="_blank" rel="noopener" class="mt-2 inline-block text-sm font-semibold text-sage underline underline-offset-4">
            {p.giftCta}
          </a>
        </div>
      </div>
      <div class="flex gap-4 rounded-3xl border border-line bg-surface p-6">
        <Info size={28} weight="duotone" className="shrink-0 text-muted" />
        <div>
          <h3 class="text-base font-semibold text-ink">{p.rulesTitle}</h3>
          <ul class="mt-1 flex flex-col gap-1 text-sm text-ink-soft">
            {p.rules.map((r) => <li>{r}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
