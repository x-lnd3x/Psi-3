---
import { getCollection } from 'astro:content';
import { ArrowUpRight } from '@phosphor-icons/react';
import { localePath, type Lang } from '../lib/site';
import { t } from '../i18n';

interface Props {
  lang: Lang;
  limit?: number;
}
const { lang, limit } = Astro.props;
const d = t(lang);
const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const list = limit ? posts.slice(0, limit) : posts;
const fmt = new Intl.DateTimeFormat('ru-RU', { day: 'numeric', month: 'long' });
---

<ul class="grid gap-4 md:grid-cols-3">
  {
    list.map((p, i) => (
      <li>
        <a
          href={localePath(lang, `/blog/${p.id}/`)}
          class="glow-card group flex h-full flex-col rounded-3xl border border-line bg-surface p-6 transition duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-1 hover:border-sage/30"
        >
          <div class="mb-8 flex items-center justify-between">
            <span class:list={['rounded-full px-3 py-1 text-xs font-semibold', i % 2 ? 'bg-sky-tint text-sky' : 'bg-sage-tint text-sage-deep']}>
              {p.data.tag}
            </span>
            <ArrowUpRight size={20} className="text-muted transition-transform duration-500 group-hover:-translate-y-1 group-hover:translate-x-1 group-hover:text-sage" />
          </div>
          <h3 class="text-xl font-semibold text-ink">{p.data.title}</h3>
          <p class="mt-3 flex-1 text-base text-muted">{p.data.description}</p>
          <p class="mt-6 text-sm text-muted">
            <time datetime={p.data.date.toISOString()}>{fmt.format(p.data.date)}</time> · {p.data.readMinutes} {d.common.minRead}
          </p>
        </a>
      </li>
    ))
  }
</ul>
