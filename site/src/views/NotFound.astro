---
import Base from '../layouts/Base.astro';
import FamilySystem from '../components/FamilySystem';
import { localePath, type Lang } from '../lib/site';
import { t } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
---

<Base lang={lang} title={d.meta.notFoundTitle} description={d.notFound.text} path="/404/" noindex>
  <section class="px-4 pb-12 pt-32 md:px-6 md:pt-40">
    <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-2">
      <div class="flex flex-col items-start gap-6">
        <p class="text-8xl font-bold tracking-tight text-sage-tint">404</p>
        <h1 class="text-hero text-5xl font-bold tracking-tight">{d.notFound.title}</h1>
        <p class="text-lg text-ink-soft">{d.notFound.text}</p>
        <a
          href={localePath(lang, '/')}
          class="rounded-xl bg-sage px-3 py-2 text-base font-semibold text-white transition duration-300 hover:bg-sage-deep active:scale-[0.98]"
        >
          {d.common.toHome}
        </a>
      </div>
      <FamilySystem client:visible labels={d.hero.systemNodes} hint={d.hero.systemHint} />
    </div>
  </section>
</Base>
